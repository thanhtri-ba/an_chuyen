# API Configuration
VITE_API_BASE_URL=http://localhost:3000

# Supabase (optional, if using Supabase client directly)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Environment
VITE_ENV=development

# Google OAuth (Sign In With Google) — same Client ID as backend GOOGLE_CLIENT_ID.
# Safe to expose publicly; it only identifies the app to Google, it is not a secret.
VITE_GOOGLE_CLIENT_ID=
