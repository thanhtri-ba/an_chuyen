# Database
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Server
PORT=3000
NODE_ENV=development

# CORS — comma-separated list of allowed origins. REQUIRED in production;
# falls back to localhost dev ports when unset (do NOT rely on this in prod).
CORS_ORIGINS=https://anchuyen.vn,https://admin.anchuyen.vn

# Authentication
JWT_SECRET=ysupersecretjwtkey12345

# Google OAuth (Sign In With Google) — OAuth Client ID from Google Cloud
# Console (Credentials > OAuth client ID > Web application). No secret needed
# here; the backend only verifies ID tokens against this audience.
GOOGLE_CLIENT_ID=

# VNPay payment gateway — from the merchant sandbox/production dashboard.
# VNPAY_RETURN_URL must be this backend's own public URL + /api/vnpay/return
# (VNPay redirects the customer's browser there after payment).
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:3000/api/vnpay/return
FRONTEND_URL=http://localhost:5173

# Mock payment gateway — for demos/thesis defense when you don't have a real
# VNPay/MoMo merchant account yet. Simulates the same redirect-out-then-
# callback-in flow (booking stays PENDING_PAYMENT until confirmed), but the
# customer clicks "simulate success/failure" instead of entering a real card.
# Leave unset/false in any deployment you don't fully control — anyone who can
# reach this backend can mark bookings paid for free while it's "true".
MOCK_PAYMENTS_ENABLED=false

# MoMo payment gateway — from the MoMo Business (test.momo.vn / business.momo.vn)
# merchant dashboard. MOMO_REDIRECT_URL is where the customer's browser lands
# after paying (this backend's public URL + /api/momo/return); MOMO_IPN_URL is
# the server-to-server callback (this backend's public URL + /api/momo/ipn) —
# both must be public HTTPS URLs, so IPN only works once deployed.
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_ENDPOINT=https://test-payment.momo.vn/v2/gateway/api/create
MOMO_REDIRECT_URL=http://localhost:3000/api/momo/return
MOMO_IPN_URL=http://localhost:3000/api/momo/ipn

# Bank transfer via VietQR (img.vietqr.io — free, public, no signup needed).
# BANK_BIN is the bank's VietQR BIN code (e.g. 970422 = MBBank, 970436 = Vietcombank —
# full list: https://api.vietqr.io/v2/banks). Admin confirms transfers manually,
# same as COD (POST /api/payments/cod/confirm).
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NUMBER=
BANK_BIN=

# Optional — set ONE of these two to auto-confirm bank transfers instead of an
# admin manually approving them. Both services have a Free tier (1 bank
# account) — pick whichever one you register with, you don't need both. Only
# works once this backend is deployed to a public URL — neither service can
# reach localhost.

# SePay (sepay.vn) — webhook URL: this server's public URL +
# /api/bank-transfer/webhook/sepay, using this same key as the Authorization
# header value SePay sends ("Apikey <value>").
SEPAY_API_KEY=

# Casso (casso.vn) — webhook URL: this server's public URL +
# /api/bank-transfer/webhook/casso. Set this same value as the "Secure Token"
# in Casso's webhook config (dashboard > Cấu hình Webhook).
CASSO_WEBHOOK_TOKEN=

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# AI Provider (gemini or ollama)
AI_PROVIDER=gemini
GOOGLE_GENERATIVE_AI_API_KEY=your-google-api-key
GEMINI_MODEL=google/gemini-3.5-flash-lite

# Optional: Ollama (when AI_PROVIDER=ollama)
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:7b

# Error Tracking
SENTRY_DSN=

# Auth
ALLOW_DEV_AUTH_FALLBACK=false
